# Site temel URL'i (SEO/sitemap/OG için). Vercel'de gerçek domainini yaz.
NEXT_PUBLIC_SITE_URL=https://www.example.com

# İletişim formu (ContactOrb) — mesajlar e-posta ile sadece sana gider, DB yok.
# Resend (https://resend.com) ücretsiz hesap aç, bir API anahtarı oluştur.

# Zorunlu: Resend API anahtarı (sunucu tarafı; istemciye sızmaz)
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxx

# Opsiyonel: mesajların gideceği adres (varsayılan: content/profile.ts içindeki e-posta)
CONTACT_TO_EMAIL=mertefeunver09@gmail.com

# Opsiyonel: gönderen. Doğrulanmış domain yoksa Resend'in test göndericisini kullan.
# (Test modunda yalnızca hesabının kendi e-postasına gönderebilir — bizim için yeterli.)
CONTACT_FROM_EMAIL=Portfolio <onboarding@resend.dev>
